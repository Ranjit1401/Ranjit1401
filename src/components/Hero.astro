<script>
 import gsap from 'gsap';
 window.initHero = function(container=document){ container.querySelectorAll('.hero-container').forEach(c=>{const title=c.querySelector('.hero-title');if(!title||title.dataset.initialized)return;const text=title.innerText;title.innerHTML='';text.split('').forEach(char=>{const s=document.createElement('span');s.innerText=char;s.className='split-char';s.style.cssText='display:inline-block;transform:translateY(105%);opacity:0;will-change:transform';title.appendChild(s)});title.dataset.initialized='true';gsap.to(c.querySelectorAll('.split-char'),{y:'0%',opacity:1,duration:1.2,stagger:.04,ease:'power4.out',delay:.6});gsap.fromTo(c.querySelectorAll('.hero-tagline,.hero-ctas,.hero-stat'),{y:22,opacity:0},{y:0,opacity:1,duration:.8,stagger:.12,ease:'power3.out',delay:1.2})})}
</script>
